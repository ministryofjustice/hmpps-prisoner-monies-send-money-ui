{% extends "../partials/layout.njk" %}

{% set pageTitle = "Before you continue - " + applicationName %}
{% set mainClasses = "govuk-body" %}

{% block content %}

  <div class="app-user-agreement">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <div class="app-user-agreement__contents">

          <h1 class="govuk-heading-xl">Before you continue</h1>

          <p class="govuk-body-l">
            We run compliance checks to prevent fraud and other criminal behaviour.
          </p>
          <p class="govuk-body-l">
            By using this service you're agreeing to these checks and our
            <a class="govuk-link" href="/terms">terms and conditions</a> and
            <a class="govuk-link" href="/privacy">privacy policy</a>.
          </p>

          <a id="id_next_btn" class="govuk-button" data-module="govuk-button" href="{{ continueUrl }}">Continue</a>

        </div>
      </div>
    </div>
  </div>

{% endblock %}
